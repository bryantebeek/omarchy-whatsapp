pkgname=omarchy-whatsapp-git
pkgver=0.3.0
pkgrel=1
pkgdesc='Low-footprint native WhatsApp linked-device client for Omarchy'
arch=('x86_64')
url='https://github.com/bryantebeek/omarchy-whatsapp'
license=('MIT')
depends=('omarchy' 'quickshell' 'sqlite' 'systemd-libs')
makedepends=('rust>=1.94' 'git')
provides=('omarchy-whatsapp')
conflicts=('omarchy-whatsapp')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf '0.3.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$pkgname"
  cargo build --release --locked --workspace
}

check() {
  cd "$pkgname"
  cargo test --locked --workspace
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/omarchy-whatsappd "$pkgdir/usr/bin/omarchy-whatsappd"
  install -Dm755 target/release/omarchy-whatsappctl "$pkgdir/usr/bin/omarchy-whatsappctl"
  local packaged_service="$srcdir/omarchy-whatsapp-package.service"
  sed 's|%h/.local/bin/omarchy-whatsappd|/usr/bin/omarchy-whatsappd|' \
    packaging/systemd/omarchy-whatsapp.service > "$packaged_service"
  install -Dm644 "$packaged_service" \
    "$pkgdir/usr/lib/systemd/user/omarchy-whatsapp.service"
  install -Dm644 packaging/applications/com.omarchy.WhatsApp.desktop \
    "$pkgdir/usr/share/applications/com.omarchy.WhatsApp.desktop"
  install -Dm644 packaging/icons/com.omarchy.WhatsApp.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.omarchy.WhatsApp.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 ARCHITECTURE.md "$pkgdir/usr/share/doc/$pkgname/ARCHITECTURE.md"
  local plugin_root="$pkgdir/usr/share/omarchy/shell/plugins/whatsapp"
  install -Dm644 manifest.json "$plugin_root/manifest.json"
  # Derived from the repository contents so a component extracted out of
  # Panel.qml cannot be omitted from the package and break panel loading.
  local plugin_file
  for plugin_file in quickshell/*.qml quickshell/*.js quickshell/*.json \
    quickshell/icons/*; do
    install -Dm644 "$plugin_file" "$plugin_root/$plugin_file"
  done
  install -Dm644 quickshell/icons/LICENSE.tabler \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.tabler"
}
