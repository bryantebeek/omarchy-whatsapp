{
  "schemaVersion": 1,
  "id": "io.github.bryantebeek.whatsapp",
  "name": "WhatsApp",
  "version": "0.3.0",
  "author": "bryantebeek",
  "license": "MIT",
  "description": "A low-footprint WhatsApp client built into Omarchy shell.",
  "kinds": ["service", "bar-widget", "panel"],
  "activation": "on-demand",
  "entryPoints": {
    "service": "quickshell/Service.qml",
    "barWidget": "quickshell/BarWidget.qml",
    "panel": "quickshell/Panel.qml"
  },
  "barWidget": {
    "displayName": "WhatsApp",
    "description": "Connection state and unread count; opens the full WhatsApp panel.",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showUnreadCount": true,
      "hideWhenEmpty": false
    },
    "schema": [
      { "key": "showUnreadCount", "type": "bool", "label": "Show unread count" },
      { "key": "hideWhenEmpty", "type": "bool", "label": "Hide when there are no unread messages" }
    ]
  }
}
